# AROGYA Q — Application Environment Configuration

# Base URL for the real Python/FastAPI backend (model_service.py)
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to communicate with the real backend, or "false" to use offline mock services
VITE_USE_REAL_API=false

# Global request timeout in milliseconds (default: 15000ms / 15s)
VITE_API_TIMEOUT_MS=15000

# Maximum number of retry attempts for idempotent requests (GET) upon transient network failure
VITE_API_RETRY_COUNT=2
